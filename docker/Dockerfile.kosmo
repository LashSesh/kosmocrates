# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# Kosmocrates substrate tools container.
#
# Builds three self-contained binaries:
#   kosmo-substrate — CLI: text / json / markdown / summary output
#   kosmo-tui       — interactive ratatui terminal dashboard
#   kosmo-server    — HTTP server + embedded browser UI (port 7777)
#
# Multi-stage build with cargo-chef for layer-cached dependency builds.
# Workspace path is mounted at /workspace at runtime; the server binds
# to 0.0.0.0:7777 by default.
#
# Usage:
#   docker build -f docker/Dockerfile.kosmo -t kosmo-substrate .
#   docker run --rm -v $(pwd):/workspace kosmo-substrate /workspace
#   docker run --rm -p 7777:7777 --entrypoint kosmo-server kosmo-substrate --host 0.0.0.0
# ---------------------------------------------------------------------------

ARG RUST_VERSION=1.82
ARG DEBIAN_VERSION=bookworm

# ─── stage 1: chef ─────────────────────────────────────────────────────────
FROM rust:${RUST_VERSION}-slim-${DEBIAN_VERSION} AS chef
RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install --locked cargo-chef
WORKDIR /build

# ─── stage 2: planner ──────────────────────────────────────────────────────
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# ─── stage 3: builder ──────────────────────────────────────────────────────
FROM chef AS builder
COPY --from=planner /build/recipe.json recipe.json
# Cook dependencies (cached if neither Cargo.toml nor Cargo.lock changed).
RUN cargo chef cook --release --recipe-path recipe.json \
        --bin kosmo-substrate --bin kosmo-server
COPY . .
RUN cargo build --release --locked \
        --bin kosmo-substrate \
        --bin kosmo-server

# ─── stage 4: runtime ──────────────────────────────────────────────────────
FROM debian:${DEBIAN_VERSION}-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10002 kosmo \
    && useradd  --system --uid 10002 --gid kosmo --home /var/lib/kosmo kosmo \
    && mkdir -p /var/lib/kosmo /workspace \
    && chown -R kosmo:kosmo /var/lib/kosmo /workspace

COPY --from=builder /build/target/release/kosmo-substrate /usr/local/bin/
COPY --from=builder /build/target/release/kosmo-server    /usr/local/bin/

USER kosmo
WORKDIR /workspace

# Default: run the CLI on the mounted workspace.
# Override ENTRYPOINT to use kosmo-server instead.
EXPOSE 7777
ENV KOSMO_SERVER_HOST=0.0.0.0 \
    KOSMO_SERVER_PORT=7777

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:7777/api/health" || exit 1

ENTRYPOINT ["/usr/local/bin/kosmo-substrate"]
CMD ["/workspace"]
