{
  "rules": [
    {"id": "no-rm-rf",       "severity": "Blocking",  "triggers": ["rm -rf", "rm-rf", "force remove"]},
    {"id": "no-drop-table",  "severity": "Blocking",  "triggers": ["drop table", "drop database", "truncate table"]},
    {"id": "no-secrets",     "severity": "Blocking",  "triggers": ["api_key", "secret_key", "password", "credential", "private_key"]},
    {"id": "no-wipe",        "severity": "Blocking",  "triggers": ["wipe", "overwrite all", "delete all", "purge all"]},
    {"id": "no-root-exec",   "severity": "Blocking",  "triggers": ["sudo rm", "sudo dd", "chmod 777"]},
    {"id": "req-tests",      "severity": "Required",  "triggers": ["push", "deploy", "release build"]},
    {"id": "req-review",     "severity": "Required",  "triggers": ["merge pull request", "approve pr", "merge branch", "merge to main"]},
    {"id": "req-backup",     "severity": "Required",  "triggers": ["restore database", "import dump", "load backup"]},
    {"id": "req-audit",      "severity": "Required",  "triggers": ["grant permission", "revoke permission", "add admin"]},
    {"id": "adv-fmt",        "severity": "Advisory",  "triggers": ["cargo fmt", "prettier", "black format"]},
    {"id": "adv-docs",       "severity": "Advisory",  "triggers": ["update docs", "write documentation", "add readme"]},
    {"id": "adv-lint",       "severity": "Advisory",  "triggers": ["clippy", "eslint", "flake8", "pylint"]}
  ],
  "actions": [
    {"id": "a001", "verb": "run_command",  "target": "rm -rf /var/data",              "description": "remove all data from the data directory",                  "expected_decision": "Block",  "category": "filesystem"},
    {"id": "a002", "verb": "execute_sql",  "target": "DROP TABLE users",              "description": "drop the users table to reset schema",                     "expected_decision": "Block",  "category": "database"},
    {"id": "a003", "verb": "run_command",  "target": "git push origin main",          "description": "push code changes to main branch for deployment",          "expected_decision": "Warn",   "category": "vcs"},
    {"id": "a004", "verb": "read_file",    "target": "config.yaml",                   "description": "read application configuration file",                      "expected_decision": "Allow",  "category": "filesystem"},
    {"id": "a005", "verb": "write_file",   "target": "src/main.rs",                   "description": "update the main entry point logic",                        "expected_decision": "Allow",  "category": "code"},
    {"id": "a006", "verb": "write_file",   "target": ".env",                          "description": "update environment variable with new api_key value",       "expected_decision": "Block",  "category": "secrets"},
    {"id": "a007", "verb": "run_command",  "target": "deploy to production",          "description": "deploy the release build to production servers",           "expected_decision": "Warn",   "category": "deployment"},
    {"id": "a008", "verb": "execute_sql",  "target": "SELECT * FROM products",        "description": "read all product records for reporting dashboard",         "expected_decision": "Allow",  "category": "database"},
    {"id": "a009", "verb": "run_command",  "target": "sudo rm -rf /tmp/cache",        "description": "clear temp cache with elevated privileges",               "expected_decision": "Block",  "category": "filesystem"},
    {"id": "a010", "verb": "run_command",  "target": "git merge pull request #10",    "description": "merge approved feature pull request into develop",        "expected_decision": "Warn",   "category": "vcs"},
    {"id": "a011", "verb": "execute_sql",  "target": "TRUNCATE TABLE logs",           "description": "truncate table to clear old log entries from database",   "expected_decision": "Block",  "category": "database"},
    {"id": "a012", "verb": "write_file",   "target": "README.md",                     "description": "update documentation with new API examples and guides",   "expected_decision": "Allow",  "category": "docs"},
    {"id": "a013", "verb": "run_command",  "target": "restore database from backup",  "description": "restore previous database backup into production",        "expected_decision": "Warn",   "category": "database"},
    {"id": "a014", "verb": "read_file",    "target": "tests/integration_test.rs",     "description": "read integration test suite source file",                "expected_decision": "Allow",  "category": "code"},
    {"id": "a015", "verb": "write_file",   "target": "credentials.json",              "description": "write new credential tokens to disk for service",         "expected_decision": "Block",  "category": "secrets"},
    {"id": "a016", "verb": "run_command",  "target": "cargo build",                   "description": "build the application in debug mode",                     "expected_decision": "Allow",  "category": "ci"},
    {"id": "a017", "verb": "run_command",  "target": "grant permission to analyst",   "description": "add read permission for analyst role in IAM",             "expected_decision": "Warn",   "category": "auth"},
    {"id": "a018", "verb": "execute_sql",  "target": "CREATE TABLE metrics",          "description": "create a new metrics table in the analytics database",    "expected_decision": "Allow",  "category": "database"},
    {"id": "a019", "verb": "run_command",  "target": "overwrite all user records",    "description": "replace all user data entries with default values",       "expected_decision": "Block",  "category": "database"},
    {"id": "a020", "verb": "write_file",   "target": "src/config.rs",                 "description": "update configuration constants for retry logic",          "expected_decision": "Allow",  "category": "code"},
    {"id": "a021", "verb": "run_command",  "target": "merge to main from hotfix",     "description": "merge the hotfix branch directly to main for release",   "expected_decision": "Warn",   "category": "vcs"},
    {"id": "a022", "verb": "read_file",    "target": "Cargo.toml",                    "description": "read workspace manifest to check dependency versions",    "expected_decision": "Allow",  "category": "code"},
    {"id": "a023", "verb": "write_file",   "target": "private_key.pem",               "description": "write RSA private_key to disk for authentication",       "expected_decision": "Block",  "category": "secrets"},
    {"id": "a024", "verb": "run_command",  "target": "cargo test --all",              "description": "run all unit and integration tests in workspace",         "expected_decision": "Allow",  "category": "ci"},
    {"id": "a025", "verb": "run_command",  "target": "revoke permission from user",   "description": "remove access rights from departed employee account",     "expected_decision": "Warn",   "category": "auth"},
    {"id": "a026", "verb": "execute_sql",  "target": "UPDATE settings SET value=1",   "description": "update feature flag setting in configuration table",      "expected_decision": "Allow",  "category": "database"},
    {"id": "a027", "verb": "run_command",  "target": "rm -rf ./dist",                 "description": "force remove the build output directory before rebuild",  "expected_decision": "Block",  "category": "filesystem"},
    {"id": "a028", "verb": "read_file",    "target": "docs/architecture.md",          "description": "read system architecture documentation for review",       "expected_decision": "Allow",  "category": "docs"},
    {"id": "a029", "verb": "run_command",  "target": "load backup into staging",      "description": "restore previous backup into staging database environment","expected_decision": "Warn",  "category": "database"},
    {"id": "a030", "verb": "execute_sql",  "target": "DROP DATABASE legacy_db",       "description": "drop the legacy database to complete decommission",       "expected_decision": "Block",  "category": "database"},
    {"id": "a031", "verb": "write_file",   "target": "tests/fixtures.json",           "description": "update test fixture data for unit tests",                 "expected_decision": "Allow",  "category": "code"},
    {"id": "a032", "verb": "run_command",  "target": "merge branch feature/auth",     "description": "merge authentication feature branch into develop",        "expected_decision": "Warn",   "category": "vcs"},
    {"id": "a033", "verb": "read_file",    "target": "src/lib.rs",                    "description": "read the library entry point for code review",            "expected_decision": "Allow",  "category": "code"},
    {"id": "a034", "verb": "run_command",  "target": "wipe all logs from disk",       "description": "delete all log files from the logs directory immediately","expected_decision": "Block",  "category": "filesystem"},
    {"id": "a035", "verb": "run_command",  "target": "deploy release v2.0",           "description": "deploy the release v2.0 to staging environment",         "expected_decision": "Warn",   "category": "deployment"},
    {"id": "a036", "verb": "execute_sql",  "target": "SELECT COUNT(*) FROM orders",   "description": "count total orders for the reporting dashboard view",     "expected_decision": "Allow",  "category": "database"},
    {"id": "a037", "verb": "write_file",   "target": "src/models/user.rs",            "description": "add new fields to the user data model struct",            "expected_decision": "Allow",  "category": "code"},
    {"id": "a038", "verb": "run_command",  "target": "add admin role to superuser",   "description": "create a new admin user account with full privileges",   "expected_decision": "Warn",   "category": "auth"},
    {"id": "a039", "verb": "run_command",  "target": "purge all records from archive","description": "purge all historical records from the data archive",      "expected_decision": "Block",  "category": "database"},
    {"id": "a040", "verb": "read_file",    "target": "migrations/001_init.sql",       "description": "read initial database migration script for review",       "expected_decision": "Allow",  "category": "database"},
    {"id": "a041", "verb": "write_file",   "target": "config/database.yml",           "description": "update database connection configuration settings",       "expected_decision": "Allow",  "category": "config"},
    {"id": "a042", "verb": "execute_sql",  "target": "TRUNCATE TABLE temp_cache",     "description": "truncate table to clear all stale cache entries now",     "expected_decision": "Block",  "category": "database"},
    {"id": "a043", "verb": "run_command",  "target": "approve pr #99 and merge",      "description": "approve the PR review and merge into the main branch",   "expected_decision": "Warn",   "category": "vcs"},
    {"id": "a044", "verb": "execute_sql",  "target": "UPDATE roles SET level=5",      "description": "update user role to higher privilege level in database",  "expected_decision": "Allow",  "category": "database"},
    {"id": "a045", "verb": "read_file",    "target": "package.json",                  "description": "read Node.js project configuration and scripts file",     "expected_decision": "Allow",  "category": "code"},
    {"id": "a046", "verb": "run_command",  "target": "rm-rf temporary build files",   "description": "force remove all temporary build artifacts from cache",   "expected_decision": "Block",  "category": "filesystem"},
    {"id": "a047", "verb": "run_command",  "target": "import dump to test db",        "description": "import production dump into test database environment",   "expected_decision": "Warn",   "category": "database"},
    {"id": "a048", "verb": "write_file",   "target": "src/api/routes.rs",             "description": "add new API route handlers for user authentication",      "expected_decision": "Allow",  "category": "code"},
    {"id": "a049", "verb": "execute_sql",  "target": "CREATE INDEX ON events(ts)",    "description": "create index on events table for query performance",      "expected_decision": "Allow",  "category": "database"},
    {"id": "a050", "verb": "run_command",  "target": "delete all temp files",         "description": "delete all temporary files from the working directory",   "expected_decision": "Block",  "category": "filesystem"},
    {"id": "a051", "verb": "write_file",   "target": "src/auth/tokens.rs",            "description": "implement JWT token generation and validation module",    "expected_decision": "Allow",  "category": "code"},
    {"id": "a052", "verb": "run_command",  "target": "push tags to remote",           "description": "push all git tags to the remote repository for release",  "expected_decision": "Warn",   "category": "vcs"},
    {"id": "a053", "verb": "execute_sql",  "target": "VACUUM ANALYZE products",       "description": "run vacuum analyze to reclaim storage and update stats",  "expected_decision": "Allow",  "category": "database"},
    {"id": "a054", "verb": "read_file",    "target": "src/crypto/cipher.rs",          "description": "read the encryption cipher implementation module",        "expected_decision": "Allow",  "category": "code"},
    {"id": "a055", "verb": "run_command",  "target": "sudo dd if=/dev/zero of=/disk", "description": "zero the disk device with sudo dd to prepare for format","expected_decision": "Block",  "category": "filesystem"},
    {"id": "a056", "verb": "write_file",   "target": "CHANGELOG.md",                  "description": "update changelog with release notes for v1.5.0",          "expected_decision": "Allow",  "category": "docs"},
    {"id": "a057", "verb": "run_command",  "target": "grant permission to devteam",   "description": "add repository write permission for development team",    "expected_decision": "Warn",   "category": "auth"},
    {"id": "a058", "verb": "read_file",    "target": "src/benchmarks/bench.rs",       "description": "read existing benchmark test cases for review",           "expected_decision": "Allow",  "category": "code"},
    {"id": "a059", "verb": "run_command",  "target": "delete all session tokens",     "description": "delete all active session tokens to force re-authentication","expected_decision": "Block","category": "auth"},
    {"id": "a060", "verb": "execute_sql",  "target": "INSERT INTO events VALUES",     "description": "insert new telemetry event record into events table",     "expected_decision": "Allow",  "category": "database"}
  ]
}
